{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fakestore-cart-contract-v1",
  "title": "FakeStore Cart Contract",
  "description": "Baseline shape snapshot for GET /carts/:id. Any response that fails this schema is a breaking change.",
  "type": "object",
  "required": ["id", "userId", "date", "products", "__v"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "integer",
      "description": "Unique cart identifier",
      "minimum": 1
    },
    "userId": {
      "type": "integer",
      "description": "ID of the user who owns this cart",
      "minimum": 1
    },
    "date": {
      "type": "string",
      "description": "Cart creation date (ISO 8601 format)"
    },
    "products": {
      "type": "array",
      "description": "List of products in the cart",
      "items": {
        "type": "object",
        "required": ["productId", "quantity"],
        "additionalProperties": false,
        "properties": {
          "productId": {
            "type": "integer",
            "description": "ID of the product",
            "minimum": 1
          },
          "quantity": {
            "type": "integer",
            "description": "Number of units",
            "minimum": 1
          }
        }
      }
    },
    "__v": {
      "type": "integer",
      "description": "Mongoose document version key",
      "minimum": 0
    }
  }
}
